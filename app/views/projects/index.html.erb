<!-- Projects index -->
<header>
  <%= render "projects_index_hero" %>
</header>
<div class="container">
  <main id="main-content">
    <section id="projects-index">
      <% if @featured_project.present? %>
        <%= render "featured_project", project: @featured_project %>
      <% end %>

      <!-- Personal projects -->
      <p class="section-eyebrow mt-5">◆ Personal</p>
      <h2 class="section-heading mb-4">My projects</h2>
      <%# Owner-only drag-to-reorder: the sortable container holds only card items. %>
      <% personal_sortable = user_signed_in? ? { controller: "sortable", sortable_url_value: reorder_projects_path } : {} %>
      <%= tag.div class: "row justify-content-start align-items-stretch", data: personal_sortable do %>
        <% @personal_projects.each do |project| %>
          <div class="col-12 col-md-6 col-lg-4 mb-4" data-id="<%= project.id %>">
            <div class="glass-card glass-card--hover overflow-hidden h-100 d-flex flex-column">
              <% if project.featured_image.attached? %>
                <div class="ratio ratio-16x9">
                  <%= image_tag project.featured_image, alt: "Project screenshot", class: "w-100 h-100", style: "object-fit: cover;", loading: "lazy" %>
                </div>
              <% elsif project.img_url.present? %>
                <div class="ratio ratio-16x9">
                  <%= image_tag project.img_url, alt: "Project screenshot", class: "w-100 h-100", style: "object-fit: cover;", loading: "lazy" %>
                </div>
              <% end %>
              <div class="p-4 d-flex flex-column flex-grow-1">
                <% if user_signed_in? %>
                  <span class="drag-handle text-soft-muted mb-2 d-inline-block" style="cursor: grab;" title="Drag to reorder">
                    <i class="fa-solid fa-grip-vertical"></i>
                  </span>
                <% end %>
                <h3 class="project-card-title mb-2"><%= project.title %></h3>
                <%# Only the title is validated — a draft saved without a
                    description must not crash the whole public index
                    (nil.capitalize raises). Same guard as show/_featured_project. %>
                <% if project.description.present? %>
                  <p class="text-body-soft mb-3">
                    <%= project.description.capitalize %>
                  </p>
                <% end %>
                <p class="project-tech-line mt-auto mb-3">
                  <%= project.tech_stack %>
                </p>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <%# Blank URLs must render NO link: a block-form link_to with a
                      nil URL silently links back to the current page. Icon-only
                      links carry aria-labels; the icons themselves are decorative. %>
                  <% if project.private_repo %>
                    <div class="d-flex justify-content-start align-items-start gap-2">
                      <% if user_signed_in? && project.github_url.present? %>
                        <%= link_to project.github_url, class: "gray-link github-btn text-decoration-none", target: "_blank", rel: "noopener", "aria-label": "#{project.title} on GitHub (private repository)" do %>
                          <i class="fa-brands fa-github fs-3" aria-hidden="true"></i>
                        <% end %>
                      <% else %>
                        <i class="fa-brands fa-github fs-3 text-soft-muted" aria-hidden="true"></i>
                      <% end %>
                      <p class="small text-soft-muted">private</p>
                    </div>
                  <% elsif project.github_url.present? %>
                    <%= link_to project.github_url, class: "gray-link github-btn text-decoration-none", target: "_blank", rel: "noopener", "aria-label": "#{project.title} on GitHub" do %>
                      <i class="fa-brands fa-github fs-3" aria-hidden="true"></i>
                    <% end %>
                  <% else %>
                    <span></span>
                  <% end %>
                  <% if project.project_url.present? %>
                    <%= link_to project.project_url, class: "btn btn-outline-light outline-d-btn rounded-4 px-4 py-2 fw-medium", target: "_blank", rel: "noopener" do %>
                      <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Live Demo
                    <% end %>
                  <% end %>
                </div>
                <!-- If user is signed-in show the 'Edit' button and if 'Project' is featured. -->
                <% if user_signed_in? %>
                  <div class="d-flex justify-content-between align-items-center mt-4">
                    <% if project.featured %>
                      <span class="chip chip--active"><i class="fa-solid fa-eye" aria-hidden="true"></i> Featured</span>
                    <% else %>
                      <span class="chip chip--learning"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Not Featured</span>
                    <% end %>
                    <%= link_to project_path(project), class: "btn btn-outline-light btn-sm rounded-4", "aria-label": "Edit #{project.title}" do %>
                      <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
      <hr class="mt-5 mb-3">
      <!-- Open source project contributions-->
      <p class="section-eyebrow mt-5">◆ Open Source</p>
      <h2 class="section-heading mb-4">Open source contributions</h2>
      <% open_source_sortable = user_signed_in? ? { controller: "sortable", sortable_url_value: reorder_projects_path } : {} %>
      <%= tag.div class: "row justify-content-start align-items-stretch", data: open_source_sortable do %>
        <% @open_source_projects.each do |project| %>
          <div class="col-12 col-md-6 col-lg-4 mb-4" data-id="<%= project.id %>">
            <div class="glass-card glass-card--hover overflow-hidden h-100 d-flex flex-column">
              <% if project.featured_image.attached? %>
                <div class="ratio ratio-16x9">
                  <%= image_tag project.featured_image, alt: "Open source project screenshot", class: "w-100 h-100", style: "object-fit: cover;", loading: "lazy" %>
                </div>
              <% elsif project.img_url.present? %>
                <div class="ratio ratio-16x9">
                  <%= image_tag project.img_url, alt: "Open source project screenshot", class: "w-100 h-100", style: "object-fit: cover;", loading: "lazy" %>
                </div>
              <% end %>
              <div class="p-4 d-flex flex-column flex-grow-1">
                <% if user_signed_in? %>
                  <span class="drag-handle text-soft-muted mb-2 d-inline-block" style="cursor: grab;" title="Drag to reorder">
                    <i class="fa-solid fa-grip-vertical"></i>
                  </span>
                <% end %>
                <h3 class="project-card-title mb-2"><%= project.title %></h3>
                <%# Same nil guard as the personal grid above. %>
                <% if project.description.present? %>
                  <p class="text-body-soft mb-3">
                    <%= project.description.capitalize %>
                  </p>
                <% end %>
                <p class="project-tech-line mt-auto mb-3">
                  <%= project.tech_stack %>
                </p>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <%# Same blank-URL guards + aria-labels as the personal grid above. %>
                  <% if project.private_repo %>
                    <div class="d-flex justify-content-start align-items-start gap-2">
                      <% if user_signed_in? && project.github_url.present? %>
                        <%= link_to project.github_url, class: "gray-link github-btn text-decoration-none", target: "_blank", rel: "noopener", "aria-label": "#{project.title} on GitHub (private repository)" do %>
                          <i class="fa-brands fa-github fs-3" aria-hidden="true"></i>
                        <% end %>
                      <% else %>
                        <i class="fa-brands fa-github fs-3 text-soft-muted" aria-hidden="true"></i>
                      <% end %>
                      <p class="small text-soft-muted">private</p>
                    </div>
                  <% elsif project.github_url.present? %>
                    <%= link_to project.github_url, class: "gray-link github-btn text-decoration-none", target: "_blank", rel: "noopener", "aria-label": "#{project.title} on GitHub" do %>
                      <i class="fa-brands fa-github fs-3" aria-hidden="true"></i>
                    <% end %>
                  <% else %>
                    <span></span>
                  <% end %>
                  <% if project.project_url.present? %>
                    <%= link_to project.project_url, class: "btn btn-outline-light outline-d-btn rounded-4 px-4 py-2 fw-medium", target: "_blank", rel: "noopener" do %>
                      <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> View Project
                    <% end %>
                  <% end %>
                </div>
                <!-- If user is signed-in show the 'Edit' button and if 'Project' is featured. -->
                <% if user_signed_in? %>
                  <div class="d-flex justify-content-between align-items-center mt-4">
                    <% if project.featured %>
                      <span class="chip chip--active"><i class="fa-solid fa-eye" aria-hidden="true"></i> Featured</span>
                    <% else %>
                      <span class="chip chip--learning"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i> Not Featured</span>
                    <% end %>
                    <%= link_to project_path(project), class: "btn btn-outline-light btn-sm rounded-4", "aria-label": "Edit #{project.title}" do %>
                      <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  </main>
</div>
