<%#
  Education & certifications — Depth Charge restyle (Task 8). Each entry
  becomes a .timeline-row (year in the mono left column, institution +
  program on the right) instead of a photo card. The year no longer repeats
  inside the right-hand copy since it now has its own column.
%>
<section id="education" class="sec justify-content-end"
         data-sec data-role="education" data-ax="0.34" data-label="Education">
  <div class="section-inner" style="max-width: 600px;">
    <p class="section-eyebrow">◆ Education</p>
    <h2 class="section-heading mb-3">Education &amp; certifications.</h2>
    <p class="text-body-soft mb-4">My education background and key certifications sorted by most recent first.</p>

    <div>
      <div class="timeline-row">
        <div class="timeline-year">2025</div>
        <div>
          <%= link_to "https://www.lewagon.com/", class: "project-card-title text-decoration-none", target: "_blank", rel: "noopener" do %>
            Le Wagon <i class="fa-solid fa-code"></i>
          <% end %>
          <p class="text-body-soft mb-0">AI Software Development Bootcamp<br>
            <span class="small">Tokyo, Japan 🇯🇵</span></p>
        </div>
      </div>

      <div class="timeline-row">
        <div class="timeline-year">2023-2024</div>
        <div>
          <%= link_to "https://www.nucamp.co/", class: "project-card-title text-decoration-none", target: "_blank", rel: "noopener" do %>
            Nucamp <i class="fa-solid fa-code"></i>
          <% end %>
          <p class="text-body-soft mb-0">Full Stack Web and Mobile Development Bootcamp<br>
            <span class="small">Online 👨‍💻</span></p>
        </div>
      </div>

      <div class="timeline-row">
        <div class="timeline-year">2020-2021</div>
        <div>
          <%= link_to "https://learntotradegroup.com/", class: "project-card-title text-decoration-none", target: "_blank", rel: "noopener" do %>
            LearnToTrade, UK <i class="fa-solid fa-chart-simple"></i>
          <% end %>
          <p class="text-body-soft mb-0">Unlimited Wealth Program<br>
            <span class="small">Online 👨‍💻</span></p>
        </div>
      </div>

      <div class="timeline-row">
        <div class="timeline-year">2018</div>
        <div>
          <%= link_to "https://digitalmarketinginstitute.com/", class: "project-card-title text-decoration-none", target: "_blank", rel: "noopener" do %>
            Digital Marketing Institute <i class="fa-solid fa-bullhorn"></i>
          <% end %>
          <p class="text-body-soft mb-0">Professional Diploma in Digital Marketing<br>
            <span class="small">Online 👨‍💻</span></p>
        </div>
      </div>

      <div class="timeline-row">
        <div class="timeline-year">2008-2011</div>
        <div>
          <%= link_to "https://www.ncl.ac.uk/", class: "project-card-title text-decoration-none", target: "_blank", rel: "noopener" do %>
            Newcastle University <i class="fa-solid fa-graduation-cap"></i>
          <% end %>
          <p class="text-body-soft mb-0">Bachelor of Science in Marine Biology<br>
            <span class="small">Newcastle Upon-Tyne, UK 🇬🇧</span></p>
        </div>
      </div>
    </div>

    <!-- Download full resume button -->
    <div class="d-flex justify-content-center mt-5">
      <%= link_to resume_path, class: "btn btn-outline-light btn-lg rounded-5" do %>
        <i class="fa-solid fa-download"></i> Download Full Resume
      <% end %>
    </div>
  </div>
</section>
