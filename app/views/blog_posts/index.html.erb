<!-- Blog posts index -->
<header>
  <%= render "blog_index_hero" %>
</header>
<div class="container">
  <main id="main-content">
    <section id="blog-posts-index">
      <p class="section-eyebrow mt-5">◆ All Posts</p>
      <%# Visually-hidden h2 keeps the heading hierarchy intact (h1 in the hero
          → h2 here → h3 post cards) without altering the eyebrow-only design.
          Without it, filtered/searched pages jumped straight from h1 to h3. %>
      <h2 class="visually-hidden">All posts</h2>

      <%# ===== SEARCH + TAG FILTER ===== %>
      <%# This GET filter form deliberately uses form_with, not simple_form_for:
          it has no model object — it only reflects params into the URL. %>
      <%= form_with url: blog_posts_path, method: :get,
            data: { controller: "blog-filter", turbo_action: "replace" } do |f| %>
        <div class="mb-3 position-relative">
          <%# A placeholder is not a label — it disappears on input and isn't
              reliably announced by assistive tech, hence the hidden label. %>
          <%= f.label :q, "Search posts by title", class: "visually-hidden" %>
          <%= f.search_field :q, value: params[:q],
                placeholder: "Search posts by title…",
                class: "form-control rounded-4",
                autocomplete: "off",
                data: { action: "input->blog-filter#search" } %>
        </div>

        <% if @all_tags.any? %>
          <% active_tag_ids = Array(params[:tag_ids]).map(&:to_s) %>
          <div class="d-flex flex-wrap gap-2 mb-4">
            <% @all_tags.each do |tag| %>
              <% tag_active = active_tag_ids.include?(tag.id.to_s) %>
              <label class="chip <%= "chip--active" if tag_active %>" style="cursor: pointer;">
                <%= check_box_tag "tag_ids[]", tag.id,
                      tag_active,
                      class: "visually-hidden",
                      data: { action: "change->blog-filter#submit" } %>
                <%= tag.name %>
              </label>
            <% end %>
            <% if active_tag_ids.any? %>
              <%= link_to "Clear filters", blog_posts_path,
                    class: "btn btn-sm btn-link", data: { turbo_action: "replace" } %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <%# Owner-only drag-to-reorder: the sortable container holds only card items. %>
      <% sortable_data = user_signed_in? ? { controller: "sortable", sortable_url_value: reorder_blog_posts_path } : {} %>

      <% if show_featured_post? && @featured_post.present? %>
        <%= render "featured_post", post: @featured_post %>
      <% end %>

      <% if @blog_posts.any? %>
        <%= tag.div class: "row justify-content-start align-items-stretch", data: sortable_data do %>
          <% @blog_posts.each do |blog_post| %>
            <div class="col-12 col-md-6 col-lg-4" data-id="<%= blog_post.id %>">
              <div class="glass-card glass-card--hover p-4 mb-4 h-100 d-flex flex-column">
                <% if user_signed_in? %>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="drag-handle text-muted d-inline-block" style="cursor: grab;" title="Drag to reorder">
                      <i class="fa-solid fa-grip-vertical"></i>
                    </span>
                    <span class="badge rounded-pill text-bg-secondary"><%= blog_post.status.capitalize %></span>
                  </div>
                <% end %>

                <%= link_to blog_post_path(blog_post), class: "text-decoration-none" do %>
                  <h3 class="project-card-title mb-3"><%= blog_post.title %></h3>
                <% end %>

                <%# .ratio reserves the thumbnail's box before the image loads
                    (no layout shift), matching the projects-index card pattern. %>
                <% if blog_post.featured_image.attached? %>
                  <div class="ratio ratio-16x9 mb-3">
                    <%= image_tag blog_post.featured_image, alt: blog_post.title, class: "rounded-4 border border-secondary w-100 h-100", style: "object-fit: cover;", loading: "lazy" %>
                  </div>
                <% elsif blog_post.img_url.present? %>
                  <div class="ratio ratio-16x9 mb-3">
                    <%= image_tag blog_post.img_url, alt: blog_post.title, class: "rounded-4 border border-secondary w-100 h-100", style: "object-fit: cover;", loading: "lazy" %>
                  </div>
                <% end %>

                <p class="project-tech-line mb-2">
                  Posted on <%= blog_post.created_at.strftime("%B %d, %Y") %>
                  &middot; <%= blog_post.reading_time %>
                </p>

                <% excerpt = blog_post.blog_excerpt.presence || blog_post.description %>
                <% if excerpt.present? %>
                  <p class="text-body-soft"><%= excerpt %></p>
                <% end %>

                <% if blog_post.tags.any? %>
                  <hr class="my-3">
                  <div class="d-flex flex-wrap gap-2">
                    <% blog_post.tags.each do |tag| %>
                      <span class="chip"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>

                <div class="d-flex justify-content-center align-items-center mt-auto">
                  <%= link_to "View Full Post", blog_post_path(blog_post), class: "btn btn-outline-light outline-d-btn rounded-4 px-4 py-2 fw-medium w-100 my-3" %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-body-soft py-4">
          <% if params[:q].present? || params[:tag_ids].present? %>
            No posts match your search or filter.
          <% else %>
            No posts published yet.
          <% end %>
        </p>
      <% end %>

      <% if @pagy.pages > 1 %>
        <nav class="mt-4" aria-label="Blog pages">
          <%= raw @pagy.series_nav(:bootstrap) %>
        </nav>
      <% end %>
    </section>
  </main>
</div>
