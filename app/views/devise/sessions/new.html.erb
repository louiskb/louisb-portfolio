<main id="main-content" class="navbar-clearance pb-5">
  <div class="container">
    <div class="glass-card p-4 p-md-5 mx-auto" style="max-width: 460px;">
      <div class="text-center">
        <p class="section-eyebrow">◆ Owner Access</p>
        <h1 class="section-heading mb-4">Log in</h1>
      </div>
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-inputs">
          <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
          <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
          <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
        </div>
        <div class="form-actions">
          <%= f.button :submit, "Log in", class: "btn btn-primary rounded-4 mt-2 mb-3" %>
        </div>
      <% end %>
      <div class="text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</main>
